{
  "path": "src/modules/eCommerce/clients/panel/private/productOrders/index.tsx",
  "title": "Product orders",
  "description": "Track and manage customer orders.",
  "help": {
    "ariaLabel": "About product orders",
    "title": "About product orders",
    "overview": "Every purchase from your online shop, plus the sales made on the till. Checkout creates the orders; here you confirm them, ship them and follow their payment.",
    "sections": [
      {
        "title": "Statuses",
        "items": [
          "Each order has three statuses: the order, its payment and its delivery. An order can be paid but not shipped yet, or shipped and partly refunded.",
          "Cash on delivery and bank transfer orders arrive unpaid: use Mark as paid when the money comes in."
        ]
      },
      {
        "title": "Step by step",
        "items": [
          "Confirm order tells the customer you have it; Mark as processing shows you are preparing it.",
          "Ship order sends everything not shipped yet, with the carrier and tracking number the customer receives. To send several parcels, create them under Fulfillments.",
          "Cancel order puts the stock it reserved back on sale. It isn't possible once the order has shipped, and a paid order must be refunded first.",
          "Refund order records all or part of the money as paid back to the customer. A full refund also disables the gift cards and downloads the order gave out."
        ]
      },
      {
        "title": "Good to know",
        "items": [
          "Returns go through Return requests. Till sales are refunded on the till, not here.",
          "The customer is told at each step, and each step is kept on the order's timeline with who did it."
        ]
      }
    ]
  },
