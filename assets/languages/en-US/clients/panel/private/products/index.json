{
  "path": "src/modules/eCommerce/clients/panel/private/products/index.tsx",
  "title": "Products",
  "description": "Manage the products in your catalog.",
  "help": {
    "ariaLabel": "About products",
    "title": "About products",
    "overview": "Everything you sell, online and on the till. Customers can buy a product only while it's Active; Draft is your working copy, and Archived takes it off sale without losing it.",
    "sections": [
      {
        "title": "Choose the type first",
        "items": [
          "Physical: shipped and kept in stock. Variable: sold in versions such as size or color, each with its own stock and, if you like, its own price (see Product variants).",
          "Digital: a download, with a download limit and expiry. Service: no shipping and no stock. Gift card: credit to spend in your shop. Bundle: a set of your other products, whose stock comes from its parts."
        ]
      },
      {
        "title": "Putting it on sale",
        "items": [
          "Publish puts a draft on sale; it needs a price unless the product has variants. A draft with a publish date goes on sale by itself when that date comes.",
          "Archive takes it off sale; Revert to draft brings an archived product back. Duplicate copies it as a new draft, without its variants, stock or reviews."
        ]
      },
      {
        "title": "Price and stock",
        "items": [
          "Price is what the customer pays before pricing rules and discount codes. Compare-at price is the struck-through “was” price; cost price is only for you.",
          "Physical and variable products sell only from stock entered under Inventory, unless Track inventory is off.",
          "Past orders keep the product's details as they were when sold, so editing a product never changes them.",
          "The other fields fill the product page: photos, videos, details, search and sharing (SEO), and related products."
        ]
      }
    ]
  },
